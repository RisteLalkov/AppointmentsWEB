@model Appointments.Contracts.PatientClinicOption
@{ ViewData["Title"] = T("Продолжи во клиниката"); }
<main class="patient-home account-admin"><a class="brand" href="/Discover"><partial name="_BrandMark" /> МедТермин.</a>
    <section class="card patient-join">
    @if (ViewData["Error"] is string error) { <p class="inline-error" role="alert">@error</p> }
    @if (Model != null) {
        <h1>@Model.Clinic.Name</h1>
        <p>@(Model.Joined ? T("Ќе се отвори вашиот работен простор во избраната клиника.") : T("Продолжувањето создава ваш пациентски профил во оваа клиника. Не е потребна нова сметка или лозинка."))</p>
        @if (!Model.Joined) { <p class="inline-note">@T("Постоечки контактни записи и историја не се поврзуваат автоматски само според е-пошта.")</p> }
        @if (Model.Available && (Model.Joined || Model.Clinic.AllowRegistration)) {
            <form asp-action="Select" method="post"><input type="hidden" name="clinicId" value="@Model.Clinic.Id"><input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]"><button class="btn primary" type="submit">@T("Продолжи во клиниката") @Icon("arrow-up-right")</button></form>
        } else { <p class="inline-note warning">@T("Клиниката не прифаќа нови онлајн пациенти или пристапот е недостапен.")</p> }
    }
    <a class="patient-home-back" href="/PatientClinics">@Icon("arrow-left") @T("Мои клиники")</a></section>
</main>
