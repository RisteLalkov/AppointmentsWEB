@using Appointments.Contracts
@model PublicClinic
@{
    var phone = new string((Model.Phone ?? "").Where(c => char.IsAsciiDigit(c) || c == '+').ToArray());
}
<section class="clinic-contact-card" aria-labelledby="clinic-info-title">
    <h2 id="clinic-info-title">Информации за клиниката</h2>
    <dl>
        <div><dt><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.5"/></svg>Адреса</dt><dd>@(string.IsNullOrWhiteSpace(Model.Address) ? "Адресата сè уште не е додадена." : Model.Address)</dd></div>
        <div><dt><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="m6 3 4 5-3 3a17 17 0 0 0 6 6l3-3 5 4c-1 6-6 4-10 1S1 9 3 5Z"/></svg>Телефон</dt><dd>@if (!string.IsNullOrWhiteSpace(phone)) { <a href="tel:@phone">@Model.Phone <span aria-hidden="true">↗</span></a> } else { <span>Телефон не е наведен.</span> }</dd></div>
    </dl>
</section>
