<!DOCTYPE html>
<html lang="mk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#176c60" />
    <title>@ViewData["Title"] · Careline</title>
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
