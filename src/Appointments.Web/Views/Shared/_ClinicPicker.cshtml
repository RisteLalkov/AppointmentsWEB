@{
    var clinics = ViewData["Clinics"] as IReadOnlyList<Appointments.Contracts.ClinicSummary> ?? [];
    var selected = ViewData["SelectedClinic"] as string;
    if (string.IsNullOrEmpty(selected) && clinics.Count == 1) selected = clinics[0].Id;
}
<div class="field">
    <label for="clinic-id">@T("Клиника")</label>
    <select id="clinic-id" name="ClinicId" required>
        @if (clinics.Count != 1) { <option value="">@T("Изберете ја вашата клиника")</option> }
        @foreach (var clinic in clinics) { <option value="@clinic.Id" selected="@(clinic.Id == selected)">@clinic.Name</option> }
    </select>
    <p class="field-help">@T("Ова е првата клиника за вашиот профил. Истата сметка подоцна можете да ја користите и во други клиники.")</p>
</div>
