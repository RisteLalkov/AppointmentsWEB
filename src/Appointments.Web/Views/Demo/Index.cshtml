@model IReadOnlyList<DemoActor>
@inject BackendSettings Backend
@{ ViewData["Title"] = T("Изберете работен простор"); }
<main class="welcome">
    <div class="welcome-story">
        <a class="brand" href="/Demo"><partial name="_BrandMark" /> МедТермин<span class="brand-dot">.</span></a>
        <div class="welcome-copy"><span class="eyebrow light">@T("ПОМАЛКУ ЧЕКАЊЕ. ПОВЕЌЕ ГРИЖА.")</span><h1>@T("Подобрите денови")<br />@T("започнуваат со")<br /><em>@T("подобра грижа.")</em></h1><p>@T("Заедничко место за пациентите, лекарите и тимот што ги поврзува.")</p></div>
        <div class="welcome-art" aria-hidden="true"><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="art-card"><span class="art-check">@Icon("check")</span><div><strong>@T("Време за вашето здравје")</strong><small>@T("Полесен начин да го закажете прегледот")</small></div></div></div>
        <footer>@T("Грижа со добра организација.") <span>@T("Европа / Скопје")</span></footer>
    </div>
    <section class="welcome-form">
        @if (ViewData["ConnectionError"] is string error) { <div class="inline-error" role="alert">@error</div> }
        @if (TempData["Error"] is string message) { <div class="inline-error" role="alert">@message</div> }
        <a href="/Account/Login" class="section-link">@T("Најава со лозинка") @Icon("arrow-right")</a>
        <div class="demo-label"><span class="dot"></span> @T("ИНТЕРАКТИВНА ДЕМО-ВЕРЗИЈА")</div>
        <h2>@T("Ваш простор.")<br />@T("Ваша перспектива.")</h2><p class="muted">@T("Изберете работен простор за да го разгледате целиот процес на закажување.")</p>
        @if (Backend.UseApi) {
            <form asp-action="Index" method="get"><partial name="_ClinicPicker" /><button class="btn secondary small" type="submit">@T("Прикажи демо-корисници")</button></form>
        }
        <div class="role-tabs" role="group" aria-label="@T("Изберете демо-улога")"><button type="button" class="active" data-role="Patient">@T("Пациент")</button><button type="button" data-role="Administrator">@T("Рецепција")</button><button type="button" data-role="Doctor">@T("Лекар")</button></div>
        <form asp-controller="Demo" asp-action="Enter" method="post" id="demo-form">
            <input type="hidden" name="ClinicId" value="@ViewData["SelectedClinic"]" />
            <label for="demo-user">@T("Продолжете како")</label>
            <select id="demo-user" name="userId" required>
                @foreach (var actor in Model) { <option value="@actor.Id" data-role="@actor.Role">@actor.Name</option> }
            </select>
            <p class="role-description" id="role-description">@T("Пронајдете лекар, изберете термин и следете ги сите закажувања на едно место.")</p>
            <button class="btn primary wide" type="submit">@T("Отвори го мојот работен простор") <span aria-hidden="true">@Icon("arrow-up-right")</span></button>
        </form>
        <aside class="demo-notice"><strong>@T("Простор за испробување")</strong><p>@T("Демо-корисниците и термините се измислени. Менувањето улоги е за тестирање и не бара лозинка. Користете само измислени податоци за пациенти.")</p></aside>
        <small class="muted">@T("Распоредите на лекарите се преземени од доставениот документ. Не се испраќаат пораки или потсетници.")</small>
    </section>
</main>
@section Scripts { <script src="~/js/demo.js" asp-append-version="true"></script> }
