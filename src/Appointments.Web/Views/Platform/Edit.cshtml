@using Appointments.Contracts
@model UpdateClinicInput
@{ ViewData["Title"] = "Податоци за клиниката"; var id = ViewData["ClinicId"] as string; }
<header class="public-header"><a class="brand" href="/Discover"><partial name="_BrandMark" /> МедТермин.</a><nav><a class="btn secondary small" asp-action="Index">← Назад кон клиниките</a></nav></header>
<main class="public-main public-profile">
    <div class="page-heading"><div><span class="eyebrow">КОМПАНИСКИ РАБОТЕН ПРОСТОР</span><h1>Податоци за клиниката</h1><p>Уредете ги јавните информации и пристапот за нови пациенти.</p></div></div>
    @if (TempData["Notice"] is string notice) { <div class="inline-note" role="status">@notice</div> }
    @if (ViewData["Error"] is string error) { <div class="inline-error" role="alert">@error <a asp-action="Edit" asp-route-id="@id">Отфрли ги внесените промени и вчитај ги тековните податоци</a></div> }
    <section class="card public-profile-card">
        <p class="muted">Идентификатор: <strong>@id</strong> · Сметките и термините се задржуваат.</p>
        <form method="post" asp-action="Edit" asp-route-id="@id" class="platform-form">
            <input type="hidden" asp-for="Version" />
            <div class="field"><label asp-for="Name">Име на клиниката</label><input asp-for="Name" minlength="2" maxlength="100" required /></div>
            <div class="field"><label asp-for="Description">Јавен опис</label><textarea asp-for="Description" maxlength="1000" rows="4"></textarea></div>
            <div class="form-row"><div class="field"><label asp-for="Address">Јавна адреса</label><input asp-for="Address" maxlength="200" /><p class="field-help">Внесете улица, број, град и држава за точна локација на мапата.</p></div><div class="field"><label asp-for="Phone">Јавен телефон</label><input asp-for="Phone" maxlength="30" /></div></div>
            <div class="field"><label><input asp-for="Discoverable" /> Прикажи ја клиниката во јавното пребарување</label></div>
            <div class="field"><label><input asp-for="AllowRegistration" /> Дозволи регистрација на нови пациенти</label></div>
            <div class="dialog-actions"><a class="btn secondary" asp-action="Index">Назад</a><button type="submit" class="btn primary">Зачувај податоци</button></div>
        </form>
    </section>
</main>
