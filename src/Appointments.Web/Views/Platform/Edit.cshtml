@using Appointments.Contracts
@model UpdateClinicInput
@{ ViewData["Title"] = T("Податоци за клиниката"); var id = ViewData["ClinicId"] as string; }
<header class="public-header"><a class="brand" href="/Discover"><partial name="_BrandMark" /> МедТермин.</a><nav><a class="btn secondary small" asp-action="Index">@Icon("arrow-left") @T("Назад кон клиниките")</a></nav></header>
<main class="public-main public-profile">
    <div class="page-heading"><div><span class="eyebrow">@T("КОМПАНИСКИ РАБОТЕН ПРОСТОР")</span><h1>@T("Податоци за клиниката")</h1><p>@T("Уредете ги јавните информации и пристапот за нови пациенти.")</p></div></div>
    @if (TempData["Notice"] is string notice) { <div class="inline-note" role="status">@notice</div> }
    @if (ViewData["Error"] is string error) { <div class="inline-error" role="alert">@error <a asp-action="Edit" asp-route-id="@id">@T("Отфрли ги внесените промени и вчитај ги тековните податоци")</a></div> }
    <section class="card public-profile-card">
        <p class="muted">@T("Идентификатор:") <strong>@id</strong> · @T("Сметките и термините се задржуваат.")</p>
        <form method="post" asp-action="Edit" asp-route-id="@id" class="platform-form">
            <input type="hidden" asp-for="Version" />
            <div class="field"><label asp-for="Name">@T("Име на клиниката")</label><input asp-for="Name" minlength="2" maxlength="100" required /></div>
            <div class="field"><label asp-for="Description">@T("Јавен опис")</label><textarea asp-for="Description" maxlength="1000" rows="4"></textarea></div>
            <div class="form-row"><div class="field"><label asp-for="Address">@T("Јавна адреса")</label><input asp-for="Address" maxlength="200" /><p class="field-help">@T("Внесете улица, број, град и држава за точна локација на мапата.")</p></div><div class="field"><label asp-for="Phone">@T("Јавен телефон")</label><input asp-for="Phone" maxlength="30" /></div></div>
            <div class="field"><label><input asp-for="Discoverable" /> @T("Прикажи ја клиниката во јавното пребарување")</label></div>
            <div class="field"><label><input asp-for="AllowRegistration" /> @T("Дозволи регистрација на нови пациенти")</label></div>
            <div class="dialog-actions"><a class="btn secondary" asp-action="Index">@T("Назад")</a><button type="submit" class="btn primary">@T("Зачувај податоци")</button></div>
        </form>
    </section>
</main>
