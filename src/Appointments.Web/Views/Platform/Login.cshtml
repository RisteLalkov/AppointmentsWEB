@{ ViewData["Title"] = T("Пристап за компанијата"); }
<main class="welcome"><div class="welcome-story"><a class="brand" href="/Discover"><partial name="_BrandMark" /> МедТермин.</a><div class="welcome-copy"><span class="eyebrow light">@T("УПРАВУВАЊЕ СО ПЛАТФОРМАТА")</span><h1>@T("Нов партнер.")<br /><em>@T("Нова грижа.")</em></h1><p>@T("Простор за овластени членови на компанијата.")</p></div></div>
<section class="welcome-form"><span class="eyebrow">@T("КОМПАНИСКИ ПРИСТАП")</span><h2>@T("Најава на платформата")</h2><p class="muted">@T("Користете ја вашата посебна компаниcка сметка. Сметките на клиниките немаат пристап овде.")</p>
@if (ViewData["Error"] is string error) { <div class="inline-error" role="alert">@error</div> }
<form method="post" asp-action="Login"><div class="field"><label for="email">@T("Е-пошта")</label><input id="email" name="Email" type="email" maxlength="120" autocomplete="username" required /></div><div class="field"><label for="password">@T("Лозинка")</label><input id="password" name="Password" type="password" maxlength="128" autocomplete="current-password" required /></div><button class="btn primary wide">@T("Најави се") @Icon("arrow-up-right")</button></form><div class="divider"></div><a href="/Account/Login">@T("Најава за корисници на клиники")</a></section></main>
