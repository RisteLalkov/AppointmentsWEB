@{ ViewData["Title"] = "Пристап за компанијата"; }
<main class="welcome"><div class="welcome-story"><a class="brand" href="/Discover"><span class="brand-mark">✚</span> careline.</a><div class="welcome-copy"><span class="eyebrow light">УПРАВУВАЊЕ СО ПЛАТФОРМАТА</span><h1>Нов партнер.<br /><em>Нова грижа.</em></h1><p>Простор за овластени членови на компанијата.</p></div></div>
<section class="welcome-form"><span class="eyebrow">КОМПАНИСКИ ПРИСТАП</span><h2>Најава на платформата</h2><p class="muted">Користете ја вашата посебна компаниcка сметка. Сметките на клиниките немаат пристап овде.</p>
@if (ViewData["Error"] is string error) { <div class="inline-error" role="alert">@error</div> }
<form method="post" asp-action="Login"><div class="field"><label for="email">Е-пошта</label><input id="email" name="Email" type="email" maxlength="120" autocomplete="username" required /></div><div class="field"><label for="password">Лозинка</label><input id="password" name="Password" type="password" maxlength="128" autocomplete="current-password" required /></div><button class="btn primary wide">Најави се ↗</button></form><div class="divider"></div><a href="/Account/Login">Најава за корисници на клиники</a></section></main>
