@model IReadOnlyList<Appointments.Contracts.PatientIdentitySummary>
@{ ViewData["Title"] = T("Поддршка за пациентски сметки"); }
<header class="public-header"><a class="brand" href="/Platform"><partial name="_BrandMark" /> МедТермин.</a><nav><a href="/Platform">@T("Клиники")</a><span>@User.Identity?.Name</span></nav></header>
<main class="public-main"><div class="page-heading"><div><span class="eyebrow">@T("КОМПАНИСКИ РАБОТЕН ПРОСТОР")</span><h1>@T("Поддршка за пациентски сметки")</h1><p>@T("Само компаниската поддршка може да обнови лична пациентска лозинка. Клиничката историја не се прикажува тука.")</p></div></div>
@if ((ViewData["Error"] ?? TempData["Error"]) is string error) { <p class="inline-error" role="alert">@error</p> }
@if (TempData["Notice"] is string notice) { <div class="success-notice" role="status" tabindex="-1"><span aria-hidden="true">@Icon("circle-check")</span><p>@notice</p></div> }
<section class="card public-profile-card"><form method="get" action="/PatientSupport"><div class="field"><label for="support-email">@T("Точна е-пошта на пациентот")</label><input id="support-email" name="email" type="email" maxlength="120" value="@ViewData["Email"]" required></div><button class="btn secondary" type="submit">@Icon("search") @T("Пребарај")</button></form></section>
@foreach (var account in Model) { <section class="card public-profile-card"><h2>@account.Name</h2><p>@account.Email</p><form asp-action="Password" method="post"><input type="hidden" name="id" value="@account.Id"><input type="hidden" name="email" value="@account.Email"><div class="field"><label for="support-password">@T("Нова лозинка")</label><input id="support-password" name="NewPassword" type="password" autocomplete="new-password" minlength="12" maxlength="128" required></div><label class="catalogue-toggle"><input name="confirmed" value="true" type="checkbox" required> @T("Го потврдив идентитетот на пациентот преку доверлив канал.")</label><p class="inline-note warning">@T("Промената важи во сите клиники и ги одјавува сите сесии. Предадете ја новата лозинка приватно; не се испраќа е-пошта.")</p><button class="btn primary" type="submit">@T("Обнови лична лозинка")</button></form></section> }
@if (Model.Count == 0 && !string.IsNullOrEmpty(ViewData["Email"] as string)) { <p class="inline-note">@T("Нема лична пациентска сметка со оваа е-пошта.")</p> }
</main>
@section Scripts { <script src="~/js/accounts.js" asp-append-version="true"></script> }
