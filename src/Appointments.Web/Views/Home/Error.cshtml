@inject BackendSettings Backend
@{ ViewData["Title"] = T("Настана грешка"); }
<main class="error-page"><partial name="_BrandMark" /><h1>@T("Не можевме да го извршиме барањето.")</h1><p>@T("Вашите зачувани термини се задржани. Вратете се во работниот простор и обидете се повторно.")</p><a class="btn primary" href="/">@T("Врати се во работниот простор")</a>@if (Backend.DemoEnabled) { <a class="btn secondary" href="/Demo">@T("Избери демо-корисник")</a> } else { <a class="btn secondary" href="/Account/Login">@T("Најави се")</a> }</main>
