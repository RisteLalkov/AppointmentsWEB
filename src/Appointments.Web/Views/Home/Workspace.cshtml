@model DemoActor
@inject Appointments.Web.Services.BackendSettings Backend
@{ var isDemo = !Backend.UseApi || User.FindFirst("demo")?.Value == "True"; }
@{ ViewData["Title"] = T("Работен простор"); ViewData["WorkspaceThemeSelector"] = true; }
<a class="skip-link" href="#main-content">@T("Прескокни до содржината")</a>
<div class="app-shell">
    <aside class="sidebar" id="sidebar" tabindex="0" aria-label="@T("Навигација и корисничка сметка")">
        <button type="button" class="icon-button sidebar-close" id="close-navigation" aria-label="@T("Затвори навигација")">@Icon("x")</button>
        <a class="brand" href="/"><partial name="_BrandMark" /> МедТермин<span class="brand-dot">.</span></a>
        @if (Backend.UseApi) { <div class="clinic-badge"><span class="eyebrow">@T("КЛИНИКА")</span><strong>@User.FindFirst("clinicName")?.Value</strong></div> }
        <div class="workspace-label">@(Model.Role == DemoRole.Administrator ? T("РАБОТЕН ПРОСТОР ЗА РЕЦЕПЦИЈА") : Model.Role == DemoRole.Doctor ? T("РАБОТЕН ПРОСТОР ЗА ЛЕКАР") : T("РАБОТЕН ПРОСТОР ЗА ПАЦИЕНТ"))</div>
        <nav aria-label="@T("Главна навигација")" id="navigation">
            <button class="nav-item active" data-page="overview"><span aria-hidden="true">@Icon("layout-dashboard")</span> @T("Преглед")</button>
            @if (Model.Role == DemoRole.Patient) {
                <button class="nav-item" data-page="doctors"><span aria-hidden="true">@Icon("stethoscope")</span> @T("Пронајди лекар")</button>
            } else {
                <button class="nav-item" data-page="calendar"><span class="nav-calendar-icon">@Icon("calendar-days")</span> @T("Календар")</button>
            }
            <button class="nav-item" data-page="appointments"><span aria-hidden="true">@Icon("clock")</span> @T("Термини")</button>
            @if (Model.Role == DemoRole.Patient) { <button class="nav-item" data-page="profile"><span aria-hidden="true">@Icon("user-round")</span> @T("Мој профил")</button> }
            @if (Model.Role != DemoRole.Patient) {
                <details class="nav-group" id="catalogue-nav">
                    <summary class="nav-item"><span aria-hidden="true">@Icon("sliders-horizontal")</span> @T("Управување")<svg class="nav-chevron" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m9 5 7 7-7 7" /></svg></summary>
                    <div class="nav-submenu"><button class="nav-item nav-child" data-page="doctors">@T("Лекари")</button><button class="nav-item nav-child" data-page="patients">@T("Пациенти")</button>
                        @if (Model.Role == DemoRole.Administrator) { <button class="nav-item nav-child" data-page="catalogue/specialties">@T("Специјалности")</button><button class="nav-item nav-child" data-page="catalogue/services">@T("Услуги")</button> }
                    </div>
                </details>
            }
            @if (Model.Role == DemoRole.Administrator) { <button class="nav-item" data-page="reports"><span aria-hidden="true">@Icon("chart-no-axes-column")</span> @T("Извештаи")</button> }
            @if (Backend.UseApi && Model.Role == DemoRole.Administrator) {
                <a class="nav-item" href="/Accounts"><span aria-hidden="true">@Icon("user-round")</span> @T("Сметки и пристап")</a>
            }
        </nav>
        <div class="sidebar-bottom">
            <div class="sidebar-account-actions"><a class="switch-user" href="/Discover"><span aria-hidden="true">@Icon("search")</span> @T("Лекари и клиники")</a>
                @if (Backend.DemoEnabled) {
                    <a class="switch-user" href="/Demo"><span aria-hidden="true">@Icon("arrow-left-right")</span> @T("Промени демо-корисник")</a>
                }
                @if (isDemo) { <div class="demo-label"><span class="dot" aria-hidden="true"></span> @T("ДЕМО-РЕЖИМ")</div> }
            </div>
        </div>
    </aside>
    <button type="button" class="navigation-backdrop" id="navigation-backdrop" aria-label="@T("Затвори навигација")" tabindex="-1" hidden></button>
    <div class="main-shell">
        <header class="topbar"><div class="topbar-left"><button class="icon-button mobile-menu" id="menu-toggle" aria-label="@T("Отвори или затвори навигација")" aria-expanded="false">@Icon("menu")</button><span class="breadcrumb">@T("Работен простор") <span>/</span> <strong id="page-label">@T("Преглед")</strong></span></div><div class="topbar-right">
            <button type="button" class="account-trigger" id="account-menu-button" aria-haspopup="dialog" aria-controls="account-settings-dialog" aria-expanded="false" aria-label="@T("Поставки на сметката за {0}", Model.Name)">
                <span class="avatar small" aria-hidden="true">@(string.IsNullOrWhiteSpace(Model.Name) ? "?" : StringInfo.GetNextTextElement(Model.Name.Trim()))</span>
                <span class="user-info"><strong>@Model.Name</strong><small>@(Model.Role == DemoRole.Administrator ? T("Рецепционер") : Model.Role.RoleLabel())@(isDemo ? T(" · Демо") : "")</small></span>
                <span class="account-trigger-chevron" aria-hidden="true">@Icon("chevron-down")</span>
            </button>
        </div></header>
        <main id="main-content" tabindex="-1"><div id="app"><div class="loading-state" role="status"><span class="spinner"></span> @T("Се подготвува вашиот работен простор…")</div></div></main>
        <footer class="app-footer"><span>МедТермин <span class="muted">/</span> @T("Повеќе спокој во секојдневието.")</span><div class="footer-preferences"><span>@(isDemo ? T("Измислени пациенти · Заеднички демо-податоци") : T("Вашите термини, на едно место."))</span></div></footer>
    </div>
</div>
<partial name="_AccountSettings" model="Model" />
<dialog id="main-dialog" aria-labelledby="dialog-title"><div class="dialog-header"><div><span class="eyebrow" id="dialog-eyebrow">@T("МЕДТЕРМИН")</span><h2 id="dialog-title">@T("Термин")</h2></div><button class="icon-button" id="close-dialog" aria-label="@T("Затвори прозорец")">@Icon("x")</button></div><div id="dialog-content"></div></dialog>
<dialog id="confirm-dialog" aria-labelledby="confirm-title"><div class="dialog-header"><h2 id="confirm-title">@T("Потврдете ја постапката")</h2></div><p id="confirm-message"></p><div class="dialog-actions"><button class="btn secondary" id="confirm-no">@T("Задржи ја тековната состојба")</button><button class="btn primary" id="confirm-yes">@T("Потврди")</button></div></dialog>
<div id="toast" class="toast" role="status" aria-live="polite"></div>
<div hidden id="csrf">@Html.AntiForgeryToken()</div>
@section Styles { <link rel="stylesheet" href="~/css/account-settings.css" asp-append-version="true" /> }
@section Scripts {
    <script src="~/js/account-settings.js" asp-append-version="true"></script>
    <script src="~/js/navigation-drawer.js" asp-append-version="true"></script>
    <script src="~/vendor/fullcalendar.min.js" asp-append-version="true"></script>
    <script src="~/js/app.js" asp-append-version="true"></script>
}
