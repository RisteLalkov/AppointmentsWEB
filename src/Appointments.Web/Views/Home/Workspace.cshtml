@model DemoActor
@inject Appointments.Web.Services.BackendSettings Backend
@{ var isDemo = !Backend.UseApi || User.FindFirst("demo")?.Value == "True"; }
@{ ViewData["Title"] = "Работен простор"; }
<a class="skip-link" href="#main-content">Прескокни до содржината</a>
<div class="app-shell">
    <aside class="sidebar" id="sidebar">
        <a class="brand" href="/"><span class="brand-mark">✚</span> careline<span class="brand-dot">.</span></a>
        <div class="workspace-label">@(Model.Role == DemoRole.Administrator ? "РАБОТЕН ПРОСТОР ЗА РЕЦЕПЦИЈА" : Model.Role == DemoRole.Doctor ? "РАБОТЕН ПРОСТОР ЗА ЛЕКАР" : "РАБОТЕН ПРОСТОР ЗА ПАЦИЕНТ")</div>
        <nav aria-label="Главна навигација" id="navigation">
            <button class="nav-item active" data-page="overview"><span aria-hidden="true">▦</span> Преглед</button>
            @if (Model.Role == DemoRole.Patient) {
                <button class="nav-item" data-page="doctors"><span aria-hidden="true">✚</span> Пронајди лекар</button>
            } else {
                <button class="nav-item" data-page="calendar"><span aria-hidden="true">▤</span> Календар</button>
            }
            <button class="nav-item" data-page="appointments"><span aria-hidden="true">◷</span> Термини</button>
            @if (Model.Role != DemoRole.Patient) {
                <button class="nav-item" data-page="patients"><span aria-hidden="true">♧</span> Пациенти</button>
                <button class="nav-item" data-page="availability"><span aria-hidden="true">☷</span> Достапност</button>
                @if (Model.Role == DemoRole.Administrator) { <button class="nav-item" data-page="doctors"><span aria-hidden="true">✚</span> Список на лекари</button> }
            }
        </nav>
        @if (Backend.UseApi && Model.Role == DemoRole.Administrator) { <a class="nav-item" href="/Accounts">♧ Сметки и пристап</a> }
        <div class="sidebar-bottom"><div class="help-card"><span class="mini-cross">✚</span><strong>Простор за подобра грижа.</strong><p>Сите термини, добро организирани.</p></div>@if (Backend.DemoEnabled) { <a class="switch-user" href="/Demo">⇄ <span>Промени демо-корисник</span></a> }
        @if (Backend.UseApi && !isDemo) { <a class="switch-user" href="/Account/Password">Промени лозинка</a> }
        <form asp-controller="Account" asp-action="Logout" method="post"><button class="switch-user logout-button" type="submit">Одјави се</button></form><div class="demo-label"><span class="dot"></span> @(isDemo ? "ДЕМО-РЕЖИМ" : "ПОВРЗАНО")</div></div>
    </aside>
    <div class="main-shell">
        <header class="topbar"><div class="topbar-left"><button class="icon-button mobile-menu" id="menu-toggle" aria-label="Отвори или затвори навигација" aria-expanded="false">☰</button><span class="breadcrumb">Работен простор <span>/</span> <strong id="page-label">Преглед</strong></span></div><div class="topbar-right"><span class="zone-label" id="zone-label">Europe/Skopje</span><span class="avatar small">@Model.Name[..1]</span><div class="user-info"><strong>@Model.Name</strong><small>@(Model.Role == DemoRole.Administrator ? "Рецепционер" : Model.Role.RoleLabel())@(isDemo ? " · Демо" : "")</small></div></div></header>
        <main id="main-content" tabindex="-1"><div id="app"><div class="loading-state" role="status"><span class="spinner"></span> Се подготвува вашиот работен простор…</div></div></main>
        <footer class="app-footer"><span>Careline <span class="muted">/</span> Повеќе спокој во секојдневието.</span><span>@(isDemo ? "Измислени пациенти · Заеднички демо-податоци" : "Вашите термини, на едно место.")</span></footer>
    </div>
</div>
<dialog id="main-dialog" aria-labelledby="dialog-title"><div class="dialog-header"><div><span class="eyebrow" id="dialog-eyebrow">CARELINE</span><h2 id="dialog-title">Термин</h2></div><button class="icon-button" id="close-dialog" aria-label="Затвори прозорец">×</button></div><div id="dialog-content"></div></dialog>
<dialog id="confirm-dialog" aria-labelledby="confirm-title"><div class="dialog-header"><h2 id="confirm-title">Потврдете ја постапката</h2></div><p id="confirm-message"></p><div class="dialog-actions"><button class="btn secondary" id="confirm-no">Задржи ја тековната состојба</button><button class="btn primary" id="confirm-yes">Потврди</button></div></dialog>
<div id="toast" class="toast" role="status" aria-live="polite"></div>
<div hidden id="csrf">@Html.AntiForgeryToken()</div>
@section Scripts {
    <script src="~/vendor/fullcalendar.min.js" asp-append-version="true"></script>
    <script src="~/js/app.js" asp-append-version="true"></script>
}
