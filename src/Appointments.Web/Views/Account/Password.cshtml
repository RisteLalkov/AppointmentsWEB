@{ ViewData["Title"] = "Промени лозинка"; }
<main class="account-page"><a class="brand" href="/"><span class="brand-mark">✚</span> careline.</a><section class="card account-card"><h1>Променете ја лозинката.</h1><p class="muted">Со промена на лозинката се одјавувате од сите активни сесии.</p>
@if (ViewData["Error"] is string error) { <div class="inline-error" role="alert">@error</div> }
<form asp-action="Password" method="post"><div class="field"><label for="current">Тековна лозинка</label><input id="current" name="CurrentPassword" type="password" autocomplete="current-password" required></div><div class="field"><label for="new">Нова лозинка</label><input id="new" name="NewPassword" type="password" autocomplete="new-password" minlength="12" maxlength="128" required></div><div class="dialog-actions"><a class="btn secondary" href="/">Назад во работниот простор</a><button class="btn primary" type="submit">Зачувај лозинка</button></div></form></section></main>
