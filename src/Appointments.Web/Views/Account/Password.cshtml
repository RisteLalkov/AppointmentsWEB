@{ ViewData["Title"] = "Change password"; }
<main class="account-page"><a class="brand" href="/"><span class="brand-mark">✚</span> careline.</a><section class="card account-card"><h1>Change your password.</h1><p class="muted">Changing your password signs out all existing sessions.</p>
@if (ViewData["Error"] is string error) { <div class="inline-error" role="alert">@error</div> }
<form asp-action="Password" method="post"><div class="field"><label for="current">Current password</label><input id="current" name="CurrentPassword" type="password" autocomplete="current-password" required></div><div class="field"><label for="new">New password</label><input id="new" name="NewPassword" type="password" autocomplete="new-password" minlength="12" maxlength="128" required></div><div class="dialog-actions"><a class="btn secondary" href="/">Back to workspace</a><button class="btn primary" type="submit">Update password</button></div></form></section></main>
