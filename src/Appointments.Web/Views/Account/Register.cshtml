@{ ViewData["Title"] = T("Создајте ја вашата сметка"); }
<main class="welcome"><div class="welcome-story"><a class="brand" href="/"><partial name="_BrandMark" /> МедТермин.</a><div class="welcome-copy"><span class="eyebrow light">@T("ВАШИОТ СЛЕДЕН ЧЕКОР ЗАПОЧНУВА ТУКА")</span><h1>@T("Повеќе време")<br />@T("за") <em>@T("вашето здравје.")</em></h1></div></div><section class="welcome-form"><h2>@T("Вашата грижа, на едно место.")</h2><p class="muted">@T("Создајте пациентска сметка за закажување и управување со термините.")</p>
@if (ViewData["Error"] is string error) { <div class="inline-error" role="alert">@error</div> }
<form asp-action="Register" method="post"><input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" /><partial name="_ClinicPicker" /><div class="field"><label for="name">@T("Име и презиме")</label><input id="name" name="Name" autocomplete="name" minlength="2" maxlength="80" required></div><div class="field"><label for="email">@T("Е-пошта")</label><input id="email" name="Email" type="email" autocomplete="email" maxlength="120" required></div><div class="field"><label for="password">@T("Лозинка")</label><input id="password" name="Password" type="password" autocomplete="new-password" minlength="12" maxlength="128" required><p class="field-help">@T("Користете најмалку 12 знаци.")</p></div><button class="btn primary wide" type="submit">@T("Создај пациентска сметка") @Icon("arrow-up-right")</button></form><div class="divider"></div><a asp-action="Login" asp-route-clinicId="@ViewData["SelectedClinic"]" asp-route-returnUrl="@ViewData["ReturnUrl"]">@T("Веќе сте регистрирани? Најавете се")</a><p class="field-help" style="margin-top:20px">@T("Ако рецепцијата веќе создала пациентски профил за вас, побарајте да ја активира вашата сметка. Самостојната регистрација создава нов профил и не поврзува постоечки профили само преку е-пошта.")</p></section></main>
