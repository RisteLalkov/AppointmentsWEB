@{ ViewData["Title"] = "Create your account"; }
<main class="welcome"><div class="welcome-story"><a class="brand" href="/"><span class="brand-mark">✚</span> careline.</a><div class="welcome-copy"><span class="eyebrow light">YOUR NEXT STEP STARTS HERE</span><h1>More time<br />for <em>your health.</em></h1></div></div><section class="welcome-form"><h2>Your care, connected.</h2><p class="muted">Create a patient account to book and manage visits.</p>
@if (ViewData["Error"] is string error) { <div class="inline-error" role="alert">@error</div> }
<form asp-action="Register" method="post"><div class="field"><label for="name">Full name</label><input id="name" name="Name" autocomplete="name" minlength="2" maxlength="80" required></div><div class="field"><label for="email">Email address</label><input id="email" name="Email" type="email" autocomplete="email" maxlength="120" required></div><div class="field"><label for="password">Password</label><input id="password" name="Password" type="password" autocomplete="new-password" minlength="12" maxlength="128" required><p class="field-help">Use at least 12 characters.</p></div><button class="btn primary wide" type="submit">Create patient account ↗</button></form><div class="divider"></div><a href="/Account/Login">Already registered? Sign in</a><p class="field-help" style="margin-top:20px">If reception already created your patient record, ask them to enable your account. Self-registration creates a new record and never links by email alone.</p></section></main>
