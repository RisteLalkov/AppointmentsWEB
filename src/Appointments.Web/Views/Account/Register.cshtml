@{ ViewData["Title"] = "Создајте ја вашата сметка"; }
<main class="welcome"><div class="welcome-story"><a class="brand" href="/"><span class="brand-mark">✚</span> careline.</a><div class="welcome-copy"><span class="eyebrow light">ВАШИОТ СЛЕДЕН ЧЕКОР ЗАПОЧНУВА ТУКА</span><h1>Повеќе време<br />за <em>вашето здравје.</em></h1></div></div><section class="welcome-form"><h2>Вашата грижа, на едно место.</h2><p class="muted">Создајте пациентска сметка за закажување и управување со термините.</p>
@if (ViewData["Error"] is string error) { <div class="inline-error" role="alert">@error</div> }
<form asp-action="Register" method="post"><div class="field"><label for="name">Име и презиме</label><input id="name" name="Name" autocomplete="name" minlength="2" maxlength="80" required></div><div class="field"><label for="email">Е-пошта</label><input id="email" name="Email" type="email" autocomplete="email" maxlength="120" required></div><div class="field"><label for="password">Лозинка</label><input id="password" name="Password" type="password" autocomplete="new-password" minlength="12" maxlength="128" required><p class="field-help">Користете најмалку 12 знаци.</p></div><button class="btn primary wide" type="submit">Создај пациентска сметка ↗</button></form><div class="divider"></div><a href="/Account/Login">Веќе сте регистрирани? Најавете се</a><p class="field-help" style="margin-top:20px">Ако рецепцијата веќе создала пациентски профил за вас, побарајте да ја активира вашата сметка. Самостојната регистрација создава нов профил и не поврзува постоечки профили само преку е-пошта.</p></section></main>
